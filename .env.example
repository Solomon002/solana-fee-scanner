# Search provider configuration
X_API_BEARER_TOKEN=your_x_api_bearer_token
ENABLE_X=false
# X bills per post read: results are cached for X_REFRESH_MINUTES and capped at X_MAX_RESULTS per search.
X_REFRESH_MINUTES=120
X_MAX_RESULTS=25
# Google News, Bing News and Bluesky need no keys. Custom Search is opt-in (closed to new customers).
ENABLE_GOOGLE_API=false
GOOGLE_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id

# Reddit is paused. Set to true only after Reddit authorizes Data API access.
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SolanaFeeScanner/1.0 (contact: you@example.com)
PORT=3001

